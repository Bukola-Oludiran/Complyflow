# ====================================================================
# ComplyFlow Dashboard — environment template
# ====================================================================
# Copy to `.env` (or `.env.production` for build-time values).
# All values are baked into the Vite build at compile time.
# ====================================================================

# REQUIRED for any non-local deploy. The ComplyFlow REST API base URL
# (no trailing slash). Falls back to http://localhost:3000 if unset.
# Example: https://complyflow.sayhitojayjay.workers.dev
VITE_COMPLYFLOW_API_URL=

# OPTIONAL. Pre-populates the tenant-id input field. Defaults to
# 'homeai-sandbox' which matches what HomeAI sends as its tenant ID.
VITE_DEFAULT_TENANT_ID=homeai-sandbox
