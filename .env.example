# ====================================================================
# ComplyFlow — environment template
# ====================================================================
# Copy to `.env` and adjust. All three vars are optional with the
# defaults shown. The dev server entrypoint is `packages/api/src/main.ts`
# (run via `npm run --workspace=packages/api dev` or the `complyflow`
# bin after build).
# ====================================================================


# --------------------------------------------------------------------
# Listener configuration
# --------------------------------------------------------------------

# OPTIONAL — default: 4318. OTLP/HTTP ingestion port. SDKs (e.g.
# HomeAPP's @complyflow/sdk) POST traces to `${endpoint}/v1/traces`
# where endpoint = http://${COMPLYFLOW_HOST}:${COMPLYFLOW_OTLP_PORT}.
COMPLYFLOW_OTLP_PORT=4318

# OPTIONAL — default: 3000. REST API port for /api/v1/violations,
# /api/v1/status, /api/v1/graph, /api/v1/topology.
#
# IMPORTANT — port 3000 conflicts with HomeAPP's default Express port.
# When running both services on the same host, set this to something
# else (e.g. 3001).
COMPLYFLOW_API_PORT=3001

# OPTIONAL — default: 127.0.0.1. Bind address for BOTH the OTLP
# receiver and the REST API. Use 0.0.0.0 to accept connections from
# other containers / hosts on a private network. Do not expose to the
# public internet without first wiring real API-key validation in
# packages/api/src/main.ts (the receiver currently accepts any
# non-empty key).
COMPLYFLOW_HOST=127.0.0.1
